<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Booklio - Notification</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #000;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        color: #fff;
      }

      .container {
        text-align: center;
        background-color: #111;
        padding: 40px 20px;
        border-radius: 12px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        max-width: 500px;
        width: 90%;
      }

      h2 {
        margin-bottom: 20px;
        font-size: 24px;
        color: #fff;
      }

      a {
        display: inline-block;
        margin-top: 15px;
        text-decoration: none;
        color: #000;
        background-color: #4caf50;
        padding: 12px 25px;
        border-radius: 6px;
        font-size: 16px;
        transition: background-color 0.3s ease;
      }

      a:hover {
        background-color: #45a049;
      }

      @media (max-width: 480px) {
        .container {
          padding: 30px 15px;
        }

        h2 {
          font-size: 20px;
        }

        a {
          width: 100%;
          box-sizing: border-box;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <% if (typeof message !== "undefined") { %>
        <h2><%= message %></h2>
        <a href="https://booklio.codenix.space">Go to Homepage</a>
      <% } else { %>
        <h2>Something went wrong.</h2>
        <a href="/">Return Home</a>
      <% } %>
    </div>
  </body>
</html>
